PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────────
# Development (Docker Compose + Neon Local):
#   DATABASE_URL=postgres://neon:npg@neon-local:5432/neondb
# Production (Neon Cloud):
#   DATABASE_URL=postgres://neondb_owner:<password>@<host>.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ─── Neon Local (development only) ──────────────────────────────────────────
# Required by the neondatabase/neon_local Docker container
NEON_API_KEY=
NEON_PROJECT_ID=
# Use PARENT_BRANCH_ID for ephemeral branches, or BRANCH_ID for a fixed branch
PARENT_BRANCH_ID=
# BRANCH_ID=

# ─── App secrets ────────────────────────────────────────────────────────────
JWT_SECRET=
ARCJET_KEY=